<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Top-level action shown in the MCP Pro menu. The base record rule on
         res.users.apikeys already restricts users to their own keys; managers
         go through Settings → Users to see everyone's keys. -->
    <record id="action_mcp_governance_apikeys" model="ir.actions.act_window">
        <field name="name">API Keys</field>
        <field name="res_model">res.users.apikeys</field>
        <field name="view_mode">kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No API keys yet.
            </p><p>
                Create an API key from your user preferences
                (top-right avatar → Preferences → Account Security → New API Key).
                Pick a role to scope the key down — without a role, the key
                inherits your full user permissions.
            </p>
        </field>
    </record>

    <!-- Inherit the API-key wizard form: insert a required Role dropdown
         between Description and Duration. The dropdown is filtered to the
         current user's own assigned roles. -->
    <record id="view_apikey_description_form_inherit" model="ir.ui.view">
        <field name="name">res.users.apikeys.description.form.mcp_pro</field>
        <field name="model">res.users.apikeys.description</field>
        <field name="inherit_id" ref="base.form_res_users_key_description"/>
        <field name="arch" type="xml">
            <!-- Insert before the parent's "Give a duration..." section so
                 the order is: Name → Role → Duration. -->
            <xpath expr="//h3[contains(., 'Give a duration')]" position="before">
                <h3 class="fw-bold">Role <span class="text-muted fw-normal">(optional)</span></h3>
                <p>
                    Pick a role to scope this key down to a narrower set of
                    permissions. Leave empty to inherit your user's full
                    permissions (the standard Odoo behaviour).
                </p>
                <field name="x_available_role_ids" invisible="1"/>
                <field name="x_role_id"
                       options="{'no_create': True, 'no_open': True}"
                       domain="[('id', 'in', x_available_role_ids)]"
                       placeholder="Select a role…"/>
                <p invisible="x_role_id" class="text-muted">
                    <em>No role: this key will have the same access as your
                    user account.</em>
                </p>
            </xpath>
        </field>
    </record>

    <!-- Inherit the "API Key Ready" show form: rewrite the misleading
         "full access to your user account" warning. With this addon, a
         key's effective permissions depend on whether a role was set. -->
    <record id="view_apikey_show_form_inherit" model="ir.ui.view">
        <field name="name">res.users.apikeys.show.form.mcp_pro</field>
        <field name="model">res.users.apikeys.show</field>
        <field name="inherit_id" ref="base.form_res_users_key_show"/>
        <!-- priority &gt;= 99 silences OCA's xml-view-dangerous-replace-low-priority
             warning. We intentionally replace the full paragraph because the
             original text wrongly promises "full access" — there is no attribute
             or invisible toggle that achieves the same. -->
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//p[contains(@class, 'alert-warning')]" position="replace">
                <p class="alert alert-warning" role="alert">
                    <strong>Important:</strong>
                    The key cannot be retrieved later. Store it securely.
                    Its effective permissions are determined by the role you
                    assigned — review and revoke from Settings → Users.
                </p>
            </xpath>
        </field>
    </record>

    <!-- Inherit the kanban view of existing keys: surface role + state. -->
    <record id="view_apikey_kanban_inherit" model="ir.ui.view">
        <field name="name">res.users.apikeys.kanban.mcp_pro</field>
        <field name="model">res.users.apikeys</field>
        <field name="inherit_id" ref="base.res_users_apikeys_view_kanban"/>
        <field name="arch" type="xml">
            <!-- Make our fields available without rendering inline at the
                 create_date position (which would concatenate them into
                 unreadable text). Render-only via the <small> blocks below. -->
            <xpath expr="//field[@name='create_date']" position="after">
                <field name="x_role_id" invisible="1"/>
                <field name="x_state" invisible="1"/>
                <field name="x_last_used" invisible="1"/>
                <field name="x_use_count" invisible="1"/>
            </xpath>
            <xpath expr="//small[contains(., 'Scope:')]" position="after">
                <small invisible="not x_role_id" class="d-block">
                    Role: <field name="x_role_id"/>
                </small>
                <small class="d-block">
                    State: <field name="x_state"/>
                    <span invisible="not x_last_used">
                        · last used <field name="x_last_used"/>
                        (<field name="x_use_count"/> calls)
                    </span>
                </small>
            </xpath>
        </field>
    </record>

</odoo>
