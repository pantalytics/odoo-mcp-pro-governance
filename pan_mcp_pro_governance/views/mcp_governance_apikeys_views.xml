<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Standard list view: user, name, role, state and usage metadata in
         columns. The base record rule on res.users.apikeys restricts regular
         users to their own keys; managers go through Settings → Users to see
         everyone's keys. The User column is therefore self-referential for
         regular users but still useful to admins reading their own keys. -->
    <record id="view_apikey_list_mcp_pro" model="ir.ui.view">
        <field name="name">res.users.apikeys.list.mcp_pro</field>
        <field name="model">res.users.apikeys</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="name" string="Name"/>
                <field name="x_role_id" string="Role"/>
                <field name="user_id"/>
                <button type="object" name="remove" title="Delete API key" icon="fa-trash"/>
            </list>
        </field>
    </record>

    <!-- Top-level action shown in the MCP Pro menu. The standard list
         view is used so users keep select / actions / search exactly
         like any other Odoo list. The `mcp_pro_apikeys_help` context
         flag is read by static/src/js/apikeys_help_banner.js, which
         injects a small "how to create a key" alert above the list
         even when records exist (the action's `help` HTML below only
         renders on the empty state). -->
    <record id="action_mcp_governance_apikeys" model="ir.actions.act_window">
        <field name="name">API Keys</field>
        <field name="res_model">res.users.apikeys</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_apikey_list_mcp_pro"/>
        <field name="context">{"mcp_pro_apikeys_help": True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No API keys yet.
            </p><p>
                Create an API key from your user preferences
                (top-right avatar → Preferences → Account Security → New API Key).
                Pick a role to scope the key down — without a role, the key
                inherits your full user permissions.
            </p><p>
                Create one key per use case (Claude, n8n, a cron script, …)
                so each one is easy to identify in the audit log and can be
                revoked on its own.
            </p>
        </field>
    </record>

    <!-- API-key wizard: one heading, one field per step. Name gets a
         placeholder and a one-sentence tooltip (no tip banner), Role gets
         the same treatment between Name and Duration. The empty Role field
         reads as the choice itself: "No role, same rights as you". -->
    <record id="view_apikey_description_form_inherit" model="ir.ui.view">
        <field name="name">res.users.apikeys.description.form.mcp_pro</field>
        <field name="model">res.users.apikeys.description</field>
        <field name="inherit_id" ref="base.form_res_users_key_description"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="placeholder">Claude, n8n, nightly report</attribute>
                <attribute name="help">One key per use. Name it after what uses it.</attribute>
            </field>
            <!-- Anchor on the `duration` field, not on the heading text:
                 inheritance runs against the translated arch, so a text
                 match breaks on any non-English instance. -->
            <xpath expr="//field[@name='duration']/preceding-sibling::h3[1]" position="before">
                <h3 class="fw-bold">Role</h3>
                <field name="x_available_role_ids" invisible="1"/>
                <field name="x_role_id"
                       options="{'no_create': True, 'no_open': True}"
                       domain="[('id', 'in', x_available_role_ids)]"
                       placeholder="No role, same rights as you"
                       help="Narrows this key to the role's rights. Only roles that fit within yours are listed."/>
            </xpath>
        </field>
    </record>

    <!-- "API Key Ready": one-sentence warning plus a Rights line that names
         the role (native arrow to open it) or says the key has the same
         rights as the account. -->
    <record id="view_apikey_show_form_inherit" model="ir.ui.view">
        <field name="name">res.users.apikeys.show.form.mcp_pro</field>
        <field name="model">res.users.apikeys.show</field>
        <field name="inherit_id" ref="base.form_res_users_key_show"/>
        <!-- priority >= 99 silences OCA's xml-view-dangerous-replace-low-priority
             warning. The original paragraph promises "full access", which is
             wrong once a role is set; there is no attribute that fixes that. -->
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//p[hasclass('alert-warning')]" position="replace">
                <group>
                    <field name="x_role_id" string="Rights" invisible="not x_role_id"/>
                    <label for="x_role_id" string="Rights" invisible="x_role_id"/>
                    <span invisible="x_role_id">Same as your account</span>
                </group>
                <p class="alert alert-warning" role="alert">
                    Copy it now. It cannot be shown again.
                </p>
            </xpath>
        </field>
    </record>

    <!-- Kanban inherit removed: action_mcp_governance_apikeys uses the list
         view exclusively. If we ever bring back a card-style view, surface
         x_role_id / x_state / x_last_used / x_use_count there. -->

</odoo>
