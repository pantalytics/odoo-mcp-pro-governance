<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mcp_governance_audit_log_tree" model="ir.ui.view">
        <field name="name">mcp.governance.audit.log.tree</field>
        <field name="model">mcp.governance.audit.log</field>
        <field name="arch" type="xml">
            <list string="Audit Log" create="false" edit="false">
                <field name="create_date" string="When"/>
                <field name="x_agent_identity_id"/>
                <field name="x_user_id"/>
                <field name="x_action"/>
                <field name="x_model_id"/>
                <field name="x_res_id"/>
                <field name="x_request_id" optional="hide"/>
                <field name="x_ip_address" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_mcp_governance_audit_log_form" model="ir.ui.view">
        <field name="name">mcp.governance.audit.log.form</field>
        <field name="model">mcp.governance.audit.log</field>
        <field name="arch" type="xml">
            <form string="Audit Log Entry" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="When"/>
                            <field name="x_agent_identity_id"/>
                            <field name="x_user_id"/>
                            <field name="x_action"/>
                        </group>
                        <group>
                            <field name="x_model_id"/>
                            <field name="x_res_id"/>
                            <field name="x_request_id"/>
                            <field name="x_ip_address"/>
                            <field name="x_prompt_hash"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="x_description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mcp_governance_audit_log_search" model="ir.ui.view">
        <field name="name">mcp.governance.audit.log.search</field>
        <field name="model">mcp.governance.audit.log</field>
        <field name="arch" type="xml">
            <search string="Audit Log">
                <field name="x_agent_identity_id"/>
                <field name="x_user_id"/>
                <field name="x_model_id"/>
                <field name="x_request_id"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('create_date', '&gt;=', (context_today()).strftime('%Y-%m-%d'))]"/>
                <filter string="Writes only" name="writes"
                        domain="[('x_action', 'in', ['create', 'update', 'delete', 'execute'])]"/>
                <group>
                    <filter string="Agent" name="group_agent" context="{'group_by': 'x_agent_identity_id'}"/>
                    <filter string="Action" name="group_action" context="{'group_by': 'x_action'}"/>
                    <filter string="Model" name="group_model" context="{'group_by': 'x_model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mcp_governance_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">mcp.governance.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No audit entries yet.
            </p><p>
                Once MCP Pro (or any integration writing to this log) is wired up,
                every agent action appears here — who, what, when, from which
                request — append-only.
            </p>
        </field>
    </record>

</odoo>
