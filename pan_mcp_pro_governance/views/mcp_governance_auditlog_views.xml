<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- auditlog.log list: surface the originating API key -->
    <record id="view_auditlog_log_tree_api_key" model="ir.ui.view">
        <field name="name">auditlog.log.list.api_key</field>
        <field name="model">auditlog.log</field>
        <field name="inherit_id" ref="pan_mcp_auditlog.view_auditlog_log_tree" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="x_api_key_id" optional="show" />
            </field>
        </field>
    </record>

    <!-- auditlog.log form: show API key in the HTTP Context group -->
    <record id="view_auditlog_log_form_api_key" model="ir.ui.view">
        <field name="name">auditlog.log.form.api_key</field>
        <field name="model">auditlog.log</field>
        <field name="inherit_id" ref="pan_mcp_auditlog.view_auditlog_log_form" />
        <field name="arch" type="xml">
            <field name="http_request_id" position="after">
                <field name="x_api_key_id" readonly="1" />
            </field>
        </field>
    </record>

    <!-- auditlog.log search: allow filtering / group-by on API key -->
    <record id="view_auditlog_log_search_api_key" model="ir.ui.view">
        <field name="name">auditlog.log.search.api_key</field>
        <field name="model">auditlog.log</field>
        <field name="inherit_id" ref="pan_mcp_auditlog.view_auditlog_log_search" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="x_api_key_id" />
            </field>
            <filter name="group_by_user_id" position="after">
                <filter
                    name="group_by_api_key"
                    string="API Key"
                    domain="[]"
                    context="{'group_by':'x_api_key_id'}"
                />
            </filter>
        </field>
    </record>

    <!-- auditlog.http.request list: surface the API key -->
    <record id="view_auditlog_http_request_tree_api_key" model="ir.ui.view">
        <field name="name">auditlog.http.request.list.api_key</field>
        <field name="model">auditlog.http.request</field>
        <field
            name="inherit_id"
            ref="pan_mcp_auditlog.view_auditlog_http_request_tree"
        />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="x_api_key_id" optional="show" />
            </field>
        </field>
    </record>

    <!-- auditlog.http.request form: show API key alongside the user -->
    <record id="view_auditlog_http_request_form_api_key" model="ir.ui.view">
        <field name="name">auditlog.http.request.form.api_key</field>
        <field name="model">auditlog.http.request</field>
        <field
            name="inherit_id"
            ref="pan_mcp_auditlog.view_auditlog_http_request_form"
        />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="x_api_key_id" readonly="1" />
            </field>
        </field>
    </record>
</odoo>
