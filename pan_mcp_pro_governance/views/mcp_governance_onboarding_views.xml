<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        "Get Started" landing page. Backed by an empty TransientModel
        (mcp.governance.get_started) so the form view always renders,
        independent of whether the user has any API keys yet.

        Why TransientModel: a form view needs *some* record to render. The
        transient lives just long enough for Odoo to draw the page; nothing
        is persisted. Earlier iteration used the nocontent help on the API
        Keys kanban, but that only shows on empty state.
    -->
    <record id="view_get_started_form" model="ir.ui.view">
        <field name="name">mcp.governance.get_started.form</field>
        <field name="model">mcp.governance.get_started</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false" duplicate="false">
                <sheet>
                    <div class="mx-auto text-center" style="max-width: 880px; padding: 3rem 1rem;">
                        <h1 class="mb-4" style="font-weight: 600;">Welcome to MCP Pro Governance.</h1>

                        <div class="mb-4">
                            <img src="/pan_mcp_pro_governance/static/description/architecture_diagram.png"
                                 alt="MCP Pro architecture: AI clients talk to MCP Pro, which optionally passes through MCP Pro Governance (this app) before reaching your Odoo."
                                 style="max-width: 100%; height: auto;"/>
                        </div>

                        <p class="text-muted mb-5" style="font-size: 1.0625rem; line-height: 1.5;">
                            This app is the optional control panel that
                            sits between MCP Pro and your Odoo. The MCP
                            Pro service itself runs on pantalytics.com.
                        </p>

                        <div class="mb-3">
                            <a class="btn btn-primary btn-lg"
                               href="https://www.pantalytics.com/apps/odoo-mcp-server"
                               target="_blank"
                               rel="noopener noreferrer"
                               role="button">
                                Don't have MCP Pro yet? Sign up →
                            </a>
                        </div>
                        <div>
                            <a class="btn btn-link text-muted"
                               href="https://pantalytics.odoo.com/knowledge/article/82"
                               target="_blank"
                               rel="noopener noreferrer">
                                Already set up? Get started →
                            </a>
                        </div>

                        <hr class="my-5" style="opacity: 0.15;"/>
                        <p class="text-muted small mb-0" style="line-height: 1.6;">
                            We're a small team in Utrecht building this
                            with care. MCP Pro is stable and used by
                            1000+ people. The MCP Pro Governance app
                            though is in public beta. Please expect
                            rough edges. Questions, bugs, ideas? Email
                            <a href="mailto:support@pantalytics.com">support@pantalytics.com</a>.
                        </p>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mcp_governance_get_started" model="ir.actions.act_window">
        <field name="name">Get Started</field>
        <field name="res_model">mcp.governance.get_started</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_get_started_form"/>
        <field name="target">current</field>
        <!-- Skip the "load existing or create new" prompt; we always want a
             fresh transient record so the form renders immediately. -->
        <field name="context">{}</field>
    </record>

</odoo>
