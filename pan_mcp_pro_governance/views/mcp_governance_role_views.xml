<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Render the role's groups using Odoo's standard Access Rights widget
        (`res_user_group_ids`) instead of the OCA default flat `many2many_tags`.

        The widget is designed to work on `implied_ids` of `res.groups`
        (per its own docstring). `res.users.role` has
        `_inherits = {"res.groups": "group_id"}`, so it exposes `implied_ids`
        and `view_group_hierarchy` directly — no Python or JS needed.

        See docs/dev/role-form-access-rights-widget.md for the upgrade note.
    -->
    <record id="view_res_users_role_form_access_rights" model="ir.ui.view">
        <field name="name">res.users.role.form.access-rights-widget</field>
        <field name="model">res.users.role</field>
        <field name="inherit_id" ref="pan_mcp_user_role.view_res_users_role_form" />
        <field name="arch" type="xml">
            <field name="implied_ids" position="attributes">
                <attribute name="widget">res_user_group_ids</attribute>
                <attribute name="options" />
            </field>
            <!--
                Explainer above the Access Rights widget: answers the
                "who will see this role in their API-key dropdown?" question
                at the moment of decision (while ticking groups).
            -->
            <field name="implied_ids" position="before">
                <p class="text-muted small mb-2">
                    This role becomes selectable as an API-key scope for any
                    user whose own access groups already include all the
                    groups ticked below.
                    <a href="https://pantalytics.odoo.com/knowledge/article/82"
                       target="_blank" rel="noopener">Learn more</a>.
                </p>
            </field>
            <!--
                Progressive-disclosure helper: visible only while the role is
                new (id is falsy). Picking a user pre-fills implied_ids via
                onchange; after first save the field disappears, so existing
                roles never carry this UI noise.
            -->
            <field name="name" position="after">
                <field name="x_copy_from_user_id"
                       invisible="id"
                       options="{'no_create': True}"
                       placeholder="Optional — start from an existing user"/>
            </field>
        </field>
    </record>
</odoo>
