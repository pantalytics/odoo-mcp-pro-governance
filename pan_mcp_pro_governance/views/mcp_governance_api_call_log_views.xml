<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        The Audit Log is `auditlog.http.request` from OCA `auditlog`.
        Tree/form/search views are shipped by that module. This file only
        defines our entry-point action and an MCP-Pro-flavoured help block.
    -->

    <record id="action_mcp_governance_api_call_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">auditlog.http.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No calls logged yet.
            </p><p>
                One row is created for every inbound HTTP request that touches an
                audited model. Configure which models are audited under
                <b>MCP Pro → Configuration → Audit Rules</b>. Filter by user to see
                only the calls made by a specific AI agent.
            </p>
        </field>
    </record>

</odoo>
