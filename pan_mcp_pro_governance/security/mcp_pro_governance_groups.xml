<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_mcp_governance" model="ir.module.category">
        <field name="name">MCP Pro</field>
        <field name="description">Data and AI governance for Odoo.</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_mcp_governance" model="res.groups.privilege">
        <field name="name">MCP Pro</field>
        <field name="category_id" ref="module_category_mcp_governance"/>
    </record>

    <record id="group_mcp_governance_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_mcp_governance"/>
        <field name="implied_ids" eval="[Command.link(ref('pan_mcp_auditlog.group_auditlog_manager'))]"/>
        <field name="comment">
            Full administration of the MCP Pro app: read the audit log,
            configure audit rules, and manage all users' API keys.
            Implies Auditlog Manager from the bundled pan_mcp_auditlog.
        </field>
    </record>

    <!--
        Admin is added to the Administrator group from hooks.py
        (post_init_hook on install, post-migration on upgrade). Doing this
        from XML does not work: `user_ids` on res.groups silently fails to
        propagate on some Odoo 19 setups, and the inverse — writing
        group_ids on the base.user_admin record — is blocked because that
        xmlid is marked noupdate.
    -->

</odoo>
