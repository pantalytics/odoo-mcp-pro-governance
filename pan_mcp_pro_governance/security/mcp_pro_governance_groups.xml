<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Version-neutral part of the security setup: the application
        category. The Administrator group itself is declared in a
        version-specific file because Odoo 19 introduced res.groups.privilege
        (group -> privilege_id -> category) while 18 links group -> category_id
        directly. The manifest loads exactly one of:
          - security/groups_privilege_v19.xml   (Odoo >= 19)
          - security/groups_legacy.xml           (Odoo <= 18)
        See docs/dev/multi-version-port-plan.md.
    -->
    <record id="module_category_mcp_governance" model="ir.module.category">
        <field name="name">MCP Pro</field>
        <field name="description">Data and AI governance for Odoo.</field>
        <field name="sequence">20</field>
    </record>

    <!--
        Admin is added to the Administrator group from hooks.py
        (post_init_hook on install, post-migration on upgrade). Doing this
        from XML does not work: `user_ids` on res.groups silently fails to
        propagate on some Odoo 19 setups, and the inverse — writing
        group_ids on the base.user_admin record — is blocked because that
        xmlid is marked noupdate.
    -->

</odoo>
