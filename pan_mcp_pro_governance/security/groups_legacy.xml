<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Odoo <= 18. There is no res.groups.privilege model; groups link to the
        application category directly via category_id. Same xmlid as the 19+
        variant (group_mcp_governance_manager) so the rest of the addon — and
        hooks.py — can reference it identically. Loaded by the manifest only on
        18 and below; see security/groups_privilege_v19.xml for the 19+ form.
    -->
    <record id="group_mcp_governance_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_mcp_governance"/>
        <field name="implied_ids" eval="[Command.link(ref('pan_mcp_auditlog.group_auditlog_manager'))]"/>
        <field name="comment">
            Full administration of the MCP Pro app: read the audit log,
            configure audit rules, and manage all users' API keys.
            Implies Auditlog Manager from the bundled pan_mcp_auditlog.
        </field>
    </record>

</odoo>
