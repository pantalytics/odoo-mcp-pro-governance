<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Odoo >= 19. Groups are organised under a res.groups.privilege, which
        carries the application category. The Administrator group references
        the privilege via privilege_id. Loaded by the manifest only on 19+;
        see security/groups_legacy.xml for the 18 equivalent.
    -->
    <record id="res_groups_privilege_mcp_governance" model="res.groups.privilege">
        <field name="name">MCP Pro</field>
        <field name="category_id" ref="module_category_mcp_governance"/>
    </record>

    <record id="group_mcp_governance_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_mcp_governance"/>
        <field name="implied_ids" eval="[Command.link(ref('pan_mcp_auditlog.group_auditlog_manager'))]"/>
        <field name="comment">
            Full administration of the MCP Pro app: read the audit log,
            configure audit rules, and manage all users' API keys.
            Implies Auditlog Manager from the bundled pan_mcp_auditlog.
        </field>
    </record>

</odoo>
