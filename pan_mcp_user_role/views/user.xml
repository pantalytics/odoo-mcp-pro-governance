<odoo>
    <!-- MCP Pro: the role sits on the Access Rights page, not on a page of
         its own, and it replaces the group widget instead of sitting next
         to it. One field decides: no role means "set rights below" and the
         standard widget shows; a role means "rights come from the role"
         and the widget is hidden (`show_alert`, the OCA compute for "has an
         enabled role line", is the switch). The upstream alert that warned
         "changes here will not be persistent" is gone: nothing persists
         because nothing is shown.

         Odoo 17/18 anchors: there is no `role` radio and no `group_ids`
         widget. `base.user_groups_view` replaces `groups_id` with generated
         groups of `sel_groups_*` / `in_group_*` fields, so the role goes on
         top of the page and those groups are hidden by what they contain.
         The 19.0 trunk anchors on `role` and `group_ids` instead. -->
    <record id="view_res_users_form_inherit" model="ir.ui.view">
        <field name="name">res.users.form.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']/*[1]" position="before">
                <group name="mcp_access_role">
                    <field name="show_alert" invisible="1" />
                    <field
                        name="role_line_ids"
                        string="Access role"
                        colspan="2"
                        help="Rights come from this role, not from the boxes below. Roles are part of MCP Pro Governance."
                    >
                        <tree editable="bottom">
                            <field name="role_id" options="{'no_create': True}" />
                            <field name="date_from" optional="hide" />
                            <field name="date_to" optional="hide" />
                        </tree>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
    <!-- Hides the generated group widget. A separate view with a high
         priority so it applies after `base.user_groups_view` has put the
         generated groups in place. -->
    <record id="view_res_users_form_inherit_hide_groups" model="ir.ui.view">
        <field name="name">res.users.form.inherit.hide.groups</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath
                expr="(//page[@name='access_rights']/group[.//field[starts-with(@name, 'sel_groups_')]])[1]"
                position="attributes"
            >
                <attribute name="invisible">show_alert</attribute>
            </xpath>
            <xpath
                expr="//page[@name='access_rights']/group[.//field[@name='user_group_warning']]"
                position="attributes"
            >
                <attribute name="invisible" add="show_alert" separator=" or " />
            </xpath>
            <xpath
                expr="(//page[@name='access_rights']/group[.//field[starts-with(@name, 'sel_groups_')]])[2]"
                position="attributes"
            >
                <attribute name="invisible" add="show_alert" separator=" or " />
            </xpath>
            <xpath
                expr="//page[@name='access_rights']/group[.//field[starts-with(@name, 'in_group_')]]"
                position="attributes"
            >
                <attribute name="invisible" add="show_alert" separator=" or " />
            </xpath>
        </field>
    </record>

    <record id="view_res_users_search_inherit" model="ir.ui.view">
        <field name="name">res.users.search.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_search" />
        <field name="arch" type="xml">
            <field name="company_ids" position="after">
                <field
                    name="role_ids"
                    filter_domain="[('role_line_ids.role_id.name','ilike',self)]"
                />
            </field>
        </field>
    </record>
    <record id="view_res_users_tree_inherit" model="ir.ui.view">
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree" />
        <field name="arch" type="xml">
            <!-- Odoo 18: the users list has no `role` column; anchor on
                 company_id (matches OCA 18.0). The 19.0 trunk anchors on
                 `role` instead. -->
            <field name="company_id" position="before">
                <field name="role_ids" widget="many2many_tags" />
            </field>
        </field>
    </record>
</odoo>
