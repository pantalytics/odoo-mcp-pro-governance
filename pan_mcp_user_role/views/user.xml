<odoo>
    <!-- MCP Pro: the role sits on the Access Rights page, not on a page of
         its own, and it replaces the group widget instead of sitting next
         to it. One field decides: no role means "set rights below" and the
         standard widget shows; a role means "rights come from the role"
         and the widget is hidden (`show_alert`, the OCA compute for "has an
         enabled role line", is the switch). The upstream alert that warned
         "changes here will not be persistent" is gone: nothing persists
         because nothing is shown.

         Odoo 17/18 anchors: there is no `role` radio and no `group_ids`
         widget. `base.user_groups_view` swaps `groups_id` for groups it
         generates from the installed apps, so this view wraps `groups_id`
         in a div first (priority 15 applies it before that view's 16) and
         the generated widget lands inside the div. The 19.0 trunk anchors
         on `role` and `group_ids` instead. -->
    <record id="view_res_users_form_inherit" model="ir.ui.view">
        <field name="name">res.users.form.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="priority">15</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']/*[1]" position="before">
                <group name="mcp_access_role">
                    <field name="show_alert" invisible="1" />
                    <field
                        name="role_line_ids"
                        string="Access role"
                        colspan="2"
                        help="Leave empty to set rights by hand below. When one or more roles are linked to this user, their rights are used. Roles are additive."
                    >
                        <list editable="bottom">
                            <control>
                                <create string="Add a role" />
                            </control>
                            <field name="role_id" options="{'no_create': True}" />
                        </list>
                    </field>
                </group>
            </xpath>
            <field name="groups_id" position="replace">
                <div name="mcp_rights_by_hand" invisible="show_alert">
                    <field name="groups_id" />
                </div>
            </field>
        </field>
    </record>

    <record id="view_res_users_search_inherit" model="ir.ui.view">
        <field name="name">res.users.search.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_search" />
        <field name="arch" type="xml">
            <field name="company_ids" position="after">
                <field
                    name="role_ids"
                    filter_domain="[('role_line_ids.role_id.name','ilike',self)]"
                />
            </field>
        </field>
    </record>
    <record id="view_res_users_tree_inherit" model="ir.ui.view">
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree" />
        <field name="arch" type="xml">
            <!-- Odoo 18: the users list has no `role` column; anchor on
                 company_id (matches OCA 18.0). The 19.0 trunk anchors on
                 `role` instead. -->
            <field name="company_id" position="before">
                <field name="role_ids" widget="many2many_tags" />
            </field>
        </field>
    </record>
</odoo>
